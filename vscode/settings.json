{
    // win-dotfiles VSCode overlay. Deep-merged into %APPDATA%\Code\User\settings.json by
    // `winsmooth -Apply` (machine-specific keys are preserved). The colorCustomizations block
    // between the theme markers is rewritten by the `theme <name>` command from the active
    // palette (themes/<name>.psd1 YasbPalette), so VSCode's chrome tracks the rest of the rice.
    //
    // Syntax highlighting still follows whatever color theme you pick in VSCode; this only
    // recolours the workbench chrome (title bar, activity/side bar, tabs, status bar, panels)
    // to match the palette. titleBarStyle must be "custom" for the title-bar colours to apply.
    "editor.fontFamily": "CaskaydiaCove NF, Cascadia Code, Consolas, monospace",
    "editor.fontLigatures": true,
    "terminal.integrated.fontFamily": "CaskaydiaCove NF",
    "window.titleBarStyle": "custom",

    // win-dotfiles:theme:start
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#282828",
        "titleBar.activeForeground": "#ebdbb2",
        "titleBar.inactiveBackground": "#282828",
        "titleBar.inactiveForeground": "#a89984",
        "titleBar.border": "#3c3836",
        "activityBar.background": "#282828",
        "activityBar.foreground": "#fe8019",
        "activityBar.inactiveForeground": "#a89984",
        "activityBar.activeBorder": "#fe8019",
        "activityBarBadge.background": "#fe8019",
        "activityBarBadge.foreground": "#282828",
        "sideBar.background": "#282828",
        "sideBar.foreground": "#a89984",
        "sideBarTitle.foreground": "#ebdbb2",
        "sideBarSectionHeader.background": "#3c3836",
        "sideBarSectionHeader.foreground": "#ebdbb2",
        "statusBar.background": "#282828",
        "statusBar.foreground": "#a89984",
        "statusBar.noFolderBackground": "#282828",
        "statusBar.debuggingBackground": "#fe8019",
        "statusBar.debuggingForeground": "#282828",
        "editor.background": "#282828",
        "editorGroupHeader.tabsBackground": "#282828",
        "tab.activeBackground": "#3c3836",
        "tab.inactiveBackground": "#282828",
        "tab.activeForeground": "#ebdbb2",
        "tab.inactiveForeground": "#a89984",
        "tab.activeBorderTop": "#fe8019",
        "tab.border": "#282828",
        "panel.background": "#282828",
        "panelTitle.activeForeground": "#ebdbb2",
        "button.background": "#fe8019",
        "button.foreground": "#282828",
        "button.hoverBackground": "#8ec07c",
        "focusBorder": "#fe8019",
        "list.activeSelectionBackground": "#3c3836",
        "list.activeSelectionForeground": "#ebdbb2",
        "list.hoverBackground": "#3c3836",
        "badge.background": "#fe8019",
        "badge.foreground": "#282828",
        "terminal.background": "#282828",
        "terminal.foreground": "#ebdbb2"
    }
    // win-dotfiles:theme:end
}
