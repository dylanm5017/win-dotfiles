{
    // win-dotfiles VSCode overlay. Deep-merged into %APPDATA%\Code\User\settings.json by
    // `winsmooth -Apply` (machine-specific keys are preserved). The colorCustomizations block
    // between the theme markers is rewritten by the `theme <name>` command from the active
    // palette (themes/<name>.psd1 YasbPalette), so VSCode's chrome tracks the rest of the rice.
    //
    // Syntax highlighting still follows whatever color theme you pick in VSCode; this only
    // recolours the workbench chrome (title bar, activity/side bar, tabs, status bar, panels)
    // to match the palette. titleBarStyle must be "custom" for the title-bar colours to apply.
    "editor.fontFamily": "CaskaydiaCove NF, Cascadia Code, Consolas, monospace",
    "editor.fontLigatures": true,
    "terminal.integrated.fontFamily": "CaskaydiaCove NF",
    "window.titleBarStyle": "custom",

    // win-dotfiles:theme:start
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#333C43",
        "titleBar.activeForeground": "#D3C6AA",
        "titleBar.inactiveBackground": "#333C43",
        "titleBar.inactiveForeground": "#859289",
        "titleBar.border": "#3A464C",
        "activityBar.background": "#333C43",
        "activityBar.foreground": "#A7C080",
        "activityBar.inactiveForeground": "#859289",
        "activityBar.activeBorder": "#A7C080",
        "activityBarBadge.background": "#A7C080",
        "activityBarBadge.foreground": "#333C43",
        "sideBar.background": "#333C43",
        "sideBar.foreground": "#859289",
        "sideBarTitle.foreground": "#D3C6AA",
        "sideBarSectionHeader.background": "#3A464C",
        "sideBarSectionHeader.foreground": "#D3C6AA",
        "statusBar.background": "#333C43",
        "statusBar.foreground": "#859289",
        "statusBar.noFolderBackground": "#333C43",
        "statusBar.debuggingBackground": "#A7C080",
        "statusBar.debuggingForeground": "#333C43",
        "editor.background": "#333C43",
        "editorGroupHeader.tabsBackground": "#333C43",
        "tab.activeBackground": "#3A464C",
        "tab.inactiveBackground": "#333C43",
        "tab.activeForeground": "#D3C6AA",
        "tab.inactiveForeground": "#859289",
        "tab.activeBorderTop": "#A7C080",
        "tab.border": "#333C43",
        "panel.background": "#333C43",
        "panelTitle.activeForeground": "#D3C6AA",
        "button.background": "#A7C080",
        "button.foreground": "#333C43",
        "button.hoverBackground": "#7FBBB3",
        "focusBorder": "#A7C080",
        "list.activeSelectionBackground": "#3A464C",
        "list.activeSelectionForeground": "#D3C6AA",
        "list.hoverBackground": "#3A464C",
        "badge.background": "#A7C080",
        "badge.foreground": "#333C43",
        "terminal.background": "#333C43",
        "terminal.foreground": "#D3C6AA"
    }
    // win-dotfiles:theme:end
}
