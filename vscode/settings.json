{
    // win-dotfiles VSCode overlay. Deep-merged into %APPDATA%\Code\User\settings.json by
    // `winsmooth -Apply` (machine-specific keys are preserved). The colorCustomizations block
    // between the theme markers is rewritten by the `theme <name>` command from the active
    // palette (themes/<name>.psd1 YasbPalette), so VSCode's chrome tracks the rest of the rice.
    //
    // Syntax highlighting still follows whatever color theme you pick in VSCode; this only
    // recolours the workbench chrome (title bar, activity/side bar, tabs, status bar, panels)
    // to match the palette. titleBarStyle must be "custom" for the title-bar colours to apply.
    "editor.fontFamily": "CaskaydiaCove NF, Cascadia Code, Consolas, monospace",
    "editor.fontLigatures": true,
    "terminal.integrated.fontFamily": "CaskaydiaCove NF",
    "window.titleBarStyle": "custom",

    // win-dotfiles:theme:start
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#F3EAD3",
        "titleBar.activeForeground": "#5C6A72",
        "titleBar.inactiveBackground": "#F3EAD3",
        "titleBar.inactiveForeground": "#939F91",
        "titleBar.border": "#EAE4CA",
        "activityBar.background": "#F3EAD3",
        "activityBar.foreground": "#8DA101",
        "activityBar.inactiveForeground": "#939F91",
        "activityBar.activeBorder": "#8DA101",
        "activityBarBadge.background": "#8DA101",
        "activityBarBadge.foreground": "#F3EAD3",
        "sideBar.background": "#F3EAD3",
        "sideBar.foreground": "#939F91",
        "sideBarTitle.foreground": "#5C6A72",
        "sideBarSectionHeader.background": "#EAE4CA",
        "sideBarSectionHeader.foreground": "#5C6A72",
        "statusBar.background": "#F3EAD3",
        "statusBar.foreground": "#939F91",
        "statusBar.noFolderBackground": "#F3EAD3",
        "statusBar.debuggingBackground": "#8DA101",
        "statusBar.debuggingForeground": "#F3EAD3",
        "editor.background": "#F3EAD3",
        "editorGroupHeader.tabsBackground": "#F3EAD3",
        "tab.activeBackground": "#EAE4CA",
        "tab.inactiveBackground": "#F3EAD3",
        "tab.activeForeground": "#5C6A72",
        "tab.inactiveForeground": "#939F91",
        "tab.activeBorderTop": "#8DA101",
        "tab.border": "#F3EAD3",
        "panel.background": "#F3EAD3",
        "panelTitle.activeForeground": "#5C6A72",
        "button.background": "#8DA101",
        "button.foreground": "#F3EAD3",
        "button.hoverBackground": "#3A94C5",
        "focusBorder": "#8DA101",
        "list.activeSelectionBackground": "#EAE4CA",
        "list.activeSelectionForeground": "#5C6A72",
        "list.hoverBackground": "#EAE4CA",
        "badge.background": "#8DA101",
        "badge.foreground": "#F3EAD3",
        "terminal.background": "#F3EAD3",
        "terminal.foreground": "#5C6A72"
    }
    // win-dotfiles:theme:end
}
