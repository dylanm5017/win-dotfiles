{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.bar.json",
  "monitor": {
    "index": 0
  },
  "font_family": "CaskaydiaCove NF",
  "font_size": 12.5,
  "icon_scale": 1.2,
  "height": 38,
  "max_label_width": 200,
  "margin": {
    "horizontal": 0,
    "vertical": 6
  },
  "padding": {
    "horizontal": 14,
    "vertical": 4
  },
  "widget_spacing": 14,
  "transparency_alpha": 0,
  "grouping": {
    "kind": "Alignment",
    "style": "Default",
    "rounding": 12,
    "transparency_alpha": 217
  },
  "theme": {
    "palette": "Custom",
    "colours": {
      "base_00": "#F3EAD3",
      "base_01": "#EAE4CA",
      "base_02": "#E5DFC5",
      "base_03": "#DDD8BE",
      "base_04": "#939F91",
      "base_05": "#5C6A72",
      "base_06": "#5C6A72",
      "base_07": "#333C43",
      "base_08": "#F85552",
      "base_09": "#F57D26",
      "base_0a": "#DFA000",
      "base_0b": "#8DA101",
      "base_0c": "#35A77C",
      "base_0d": "#3A94C5",
      "base_0e": "#DF69BA",
      "base_0f": "#E66868"
    },
    "accent": "Base0B"
  },
  "left_widgets": [
    {
      "Komorebi": {
        "workspaces": {
          "enable": true,
          "display": "Icon",
          "hide_empty_workspaces": true
        },
        "layout": {
          "enable": true
        },
        "focused_window": {
          "enable": true,
          "show_icon": true
        }
      }
    }
  ],
  "center_widgets": [
    {
      "Time": {
        "enable": true,
        "format": "TwentyFourHour"
      }
    }
  ],
  "right_widgets": [
    {
      "Date": {
        "enable": true,
        "format": "DayDateMonthYear"
      }
    }
  ]
}
