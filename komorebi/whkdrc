.shell powershell

# Reload whkd configuration
alt + o                 : taskkill /f /im whkd.exe; Start-Process whkd -WindowStyle hidden
# Reload komorebi. `reload-configuration` only reloads legacy .ahk/.ps1 configs and is a no-op for
# a static komorebi.json, so this has to be replace-configuration against the repo file.
alt + shift + o         : komorebic replace-configuration C:\Workspace\Projects\win-dotfiles\komorebi\komorebi.json; komorebic retile

alt + i                 : komorebic toggle-shortcuts

# App shortcuts
# Launch terminal (WezTerm if installed, else Windows Terminal). Tiling-WM muscle memory.
alt + return            : if (Get-Command wezterm -ErrorAction SilentlyContinue) { Start-Process wezterm-gui } else { Start-Process wt }

# Raise-or-launch, the Hyprland way: focus the app if it is already open (switching workspace and
# unburying it from a stack as needed), else start it. Pressing again cycles that app's other
# windows. Apps and their launch commands live in powershell/apps.json.
#
# win + <letter> rather than alt: whkd grabs a combo globally, so an alt binding here would shadow
# the File/Edit menu of every app. These override the Windows defaults for the same keys.
win + b                 : & 'C:\Workspace\Projects\win-dotfiles\tools\Raise-App.ps1' browser
win + c                 : & 'C:\Workspace\Projects\win-dotfiles\tools\Raise-App.ps1' code
win + t                 : & 'C:\Workspace\Projects\win-dotfiles\tools\Raise-App.ps1' terminal
win + m                 : & 'C:\Workspace\Projects\win-dotfiles\tools\Raise-App.ps1' teams
win + y                 : & 'C:\Workspace\Projects\win-dotfiles\tools\Raise-App.ps1' music
win + e                 : & 'C:\Workspace\Projects\win-dotfiles\tools\Raise-App.ps1' files

alt + q                 : komorebic close
alt + m                 : komorebic minimize

# Focus windows
alt + h                 : komorebic focus left
alt + j                 : komorebic focus down
alt + k                 : komorebic focus up
alt + l                 : komorebic focus right
alt + shift + oem_4     : komorebic cycle-focus previous
alt + shift + oem_6     : komorebic cycle-focus next

# Move windows
alt + shift + h         : komorebic move left
alt + shift + j         : komorebic move down
alt + shift + k         : komorebic move up
alt + shift + l         : komorebic move right
alt + shift + return    : komorebic promote

# Monitors and workspace cycling. Named workspace binds below already cross monitors, so these are
# the positional fallback for "whatever is next door".
alt + oem_comma         : komorebic focus-monitor 0
alt + oem_period        : komorebic focus-monitor 1
alt + shift + oem_comma : komorebic move-to-monitor 0
alt + shift + oem_period: komorebic move-to-monitor 1
alt + left              : komorebic cycle-monitor previous
alt + right             : komorebic cycle-monitor next
alt + up                : komorebic cycle-workspace previous
alt + down              : komorebic cycle-workspace next

# Stacks. Workspaces are the primary tool now; stacking only happens automatically when a workspace
# hits its container ceiling, so these are navigation and escape hatches, not a layout choice.
alt + oem_1             : komorebic unstack
alt + shift + oem_1     : komorebic unstack-all
alt + oem_4             : komorebic cycle-stack previous
alt + oem_6             : komorebic cycle-stack next

# Resize
alt + oem_plus          : komorebic resize-axis horizontal increase
alt + oem_minus         : komorebic resize-axis horizontal decrease
alt + shift + oem_plus  : komorebic resize-axis vertical increase
alt + shift + oem_minus : komorebic resize-axis vertical decrease

# Manipulate windows
alt + t                 : komorebic toggle-float
# Lock the focused container so new windows tile around it instead of splitting it.
ctrl + alt + t          : komorebic toggle-lock

# Window manager options
alt + shift + r         : komorebic retile
alt + p                 : komorebic toggle-pause

# Layouts
alt + x                 : komorebic flip-layout horizontal
alt + y                 : komorebic flip-layout vertical
alt + shift + u         : komorebic change-layout ultrawide-vertical-stack
alt + shift + c         : komorebic change-layout columns
alt + shift + g         : komorebic change-layout grid
alt + shift + v         : komorebic change-layout vertical-stack
# Scrolling keeps a fixed number of columns visible and scrolls the rest off-screen, which is the
# non-monocle answer to a crowded workspace on a 32:9 panel.
alt + shift + n         : komorebic change-layout scrolling
alt + shift + b         : komorebic change-layout bsp

# Workspaces. Named rather than indexed, so one keypress crosses monitors: komorebi focuses the
# owning monitor first, then the workspace. alt+1-6 land on the ultrawide, alt+7-0 on the ASUS.
alt + 1                 : komorebic focus-named-workspace DEV
alt + 2                 : komorebic focus-named-workspace CODE
alt + 3                 : komorebic focus-named-workspace AGENT
alt + 4                 : komorebic focus-named-workspace DEBUG
alt + 5                 : komorebic focus-named-workspace BROWSER
alt + 6                 : komorebic focus-named-workspace MISC
alt + 7                 : komorebic focus-named-workspace COMMS
alt + 8                 : komorebic focus-named-workspace MEDIA
alt + 9                 : komorebic focus-named-workspace MAIL
alt + 0                 : komorebic focus-named-workspace EXTRA

alt + oem_3             : komorebic focus-last-workspace
alt + shift + oem_3     : komorebic move-to-last-workspace

# Move the focused window to a workspace and follow it there
alt + shift + 1         : komorebic move-to-named-workspace DEV
alt + shift + 2         : komorebic move-to-named-workspace CODE
alt + shift + 3         : komorebic move-to-named-workspace AGENT
alt + shift + 4         : komorebic move-to-named-workspace DEBUG
alt + shift + 5         : komorebic move-to-named-workspace BROWSER
alt + shift + 6         : komorebic move-to-named-workspace MISC
alt + shift + 7         : komorebic move-to-named-workspace COMMS
alt + shift + 8         : komorebic move-to-named-workspace MEDIA
alt + shift + 9         : komorebic move-to-named-workspace MAIL
alt + shift + 0         : komorebic move-to-named-workspace EXTRA

# Shove the focused window to a workspace and stay put. This is the "this workspace is getting
# crowded" gesture that replaces reaching for a stack.
ctrl + alt + 1          : komorebic send-to-named-workspace DEV
ctrl + alt + 2          : komorebic send-to-named-workspace CODE
ctrl + alt + 3          : komorebic send-to-named-workspace AGENT
ctrl + alt + 4          : komorebic send-to-named-workspace DEBUG
ctrl + alt + 5          : komorebic send-to-named-workspace BROWSER
ctrl + alt + 6          : komorebic send-to-named-workspace MISC
ctrl + alt + 7          : komorebic send-to-named-workspace COMMS
ctrl + alt + 8          : komorebic send-to-named-workspace MEDIA
ctrl + alt + 9          : komorebic send-to-named-workspace MAIL
ctrl + alt + 0          : komorebic send-to-named-workspace EXTRA
